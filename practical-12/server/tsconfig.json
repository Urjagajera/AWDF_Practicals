{
  // Self-contained (no `extends`), because this folder is a Docker build context on its own.
  // `npm run build` compiles src/ to CommonJS in dist/, which the container runs with plain node.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "jest"]
  },
  "include": ["src"]
}
